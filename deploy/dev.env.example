#!/usr/bin/env bash
# Dev environment for Sitepass on this host.
# Source from the project root:  set -a; source ./deploy/dev.env; set +a

SITEPASS_CONTROL_DOMAIN=sitepass.local
SITEPASS_PREVIEW_DOMAIN=sitepass-app.local
SITEPASS_BRAND_NAME=Sitepass
SITEPASS_LISTEN=127.0.0.1:8080
SITEPASS_BUILDS_DIR=/home/ai-agent/project/.data/builds
SITEPASS_DB_DSN=postgres://sitepass:sitepass-dev@/sitepass?host=/var/run/postgresql
SITEPASS_DEFAULT_LANGUAGE=en
SITEPASS_TOKEN_TTL_SECONDS=1800
SITEPASS_MAX_ARCHIVE_BYTES=104857600
SITEPASS_DISK_HIGH_WATER_PERCENT=80
SITEPASS_DISK_CRITICAL_PERCENT=90
# Optional maintenance gate: rejects new tokens and uploads
SITEPASS_READ_ONLY=false
SITEPASS_MAX_CONCURRENT_UPLOADS=2
SITEPASS_MIN_AVAILABLE_MEM_MB=96
SITEPASS_ABUSE_CONTACT=abuse@localhost
SITEPASS_ACME_DNS_PROVIDER=
SITEPASS_ACME_DNS_TOKEN=
SITEPASS_MIGRATIONS_DIR=migrations
SITEPASS_LLMS_PATH=llms.txt
SITEPASS_WEB_DIST=web/dist
