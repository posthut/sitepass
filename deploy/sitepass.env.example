# Sitepass environment configuration
# Copy to /etc/sitepass/sitepass.env and edit before running bootstrap.sh
# Mode 0600, owned by root. Do not commit real secrets.

# Hostname of the control site (SPA + API proxy)
SITEPASS_CONTROL_DOMAIN=sitepass.example

# Hostname for preview subdomains (*.SITEPASS_PREVIEW_DOMAIN)
# Either a different registrable domain, or the SAME value as CONTROL for
# shared-apex mode (previews at <label>.CONTROL).
SITEPASS_PREVIEW_DOMAIN=preview.example

# Brand name shown in the UI and system pages
SITEPASS_BRAND_NAME=Sitepass

# Address and port the Go API listens on (nginx proxies to this)
SITEPASS_LISTEN=127.0.0.1:8080

# Filesystem path for published build content
SITEPASS_BUILDS_DIR=/srv/sitepass/builds

# PostgreSQL connection string (unix socket recommended)
SITEPASS_DB_DSN=postgres:///sitepass?host=/var/run/postgresql

# Default UI language when none is selected (en, ru, or kk)
SITEPASS_DEFAULT_LANGUAGE=en

# Default token lifetime in seconds
SITEPASS_TOKEN_TTL_SECONDS=1800

# Default maximum compressed archive size in bytes
SITEPASS_MAX_ARCHIVE_BYTES=104857600

# Disk usage percentage at which new token creation is refused
SITEPASS_DISK_HIGH_WATER_PERCENT=80

# Disk usage percentage at which oldest live tokens are revoked
SITEPASS_DISK_CRITICAL_PERCENT=90

# Optional maintenance mode: rejects token creation and uploads
SITEPASS_READ_ONLY=false

# Abuse report contact address
SITEPASS_ABUSE_CONTACT=abuse@sitepass.example

# ACME DNS-01 provider name (for wildcard TLS on preview domain)
SITEPASS_ACME_DNS_PROVIDER=

# ACME DNS provider API token (supplied at bootstrap, never committed)
SITEPASS_ACME_DNS_TOKEN=
